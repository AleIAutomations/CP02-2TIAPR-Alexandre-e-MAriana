      "parameters": {
        "jsCode": "const raw = $input.first().json.output || '';\nconst clean = String(raw).replace(/```json|```/g, '').trim();\nlet d = null;\ntry { d = JSON.parse(clean); } catch (e) {\n  const m = clean.match(/\\{[\\s\\S]*\\}/);\n  if (m) { try { d = JSON.parse(m[0]); } catch (e2) {} }\n}\nif (!d) {\n  return [{ json: { aprovado: false, categoria: 'erro', motivo: 'Não consegui validar seu pedido com segurança. Tente reformular.', pedido: '', formatos: '' } }];\n}\nreturn [{ json: {\n  aprovado: d.aprovado === true,\n  categoria: d.categoria || '',\n  motivo: d.motivo || 'Pedido fora das regras da campanha.',\n  pedido: d.pedido || $('Telegram Trigger').first().json.message.text,\n  formatos: d.formatos || 'texto,imagem,video'\n} }];"
      },
