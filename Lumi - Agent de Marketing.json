      "parameters": {
        "jsCode": "const raw = $input.first().json.output || '';\nconst clean = String(raw).replace(/```json|```/g, '').trim();\nlet d = null;\ntry { d = JSON.parse(clean); } catch (e) {\n  const m = clean.match(/\\{[\\s\\S]*\\}/);\n  if (m) { try { d = JSON.parse(m[0]); } catch (e2) {} }\n}\nif (!d) d = { raciocinio: '', legenda: clean, prompt_imagem: clean, narracao: clean };\nreturn [{ json: {\n  raciocinio: d.raciocinio || '',\n  legenda: d.legenda || '',\n  prompt_imagem: d.prompt_imagem || '',\n  narracao: d.narracao || ''\n} }];"
      },
      "name": "Organizar saída da Lumi",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
