        "jsCode": "const orig = $('Organizar saída da Lumi').first().json;\nconst raw = $input.first().json.output || '';\nconst clean = String(raw).replace(/```json|```/g, '').trim();\nlet d = null;\ntry { d = JSON.parse(clean); } catch (e) {\n  const m = clean.match(/\\{[\\s\\S]*\\}/);\n  if (m) { try { d = JSON.parse(m[0]); } catch (e2) {} }\n}\nif (!d) {\n  return [{ json: { ...orig, aprovado: false, problemas: ['Resposta do Revisor inválida (bloqueio por segurança)'] } }];\n}\nreturn [{ json: {\n  aprovado: d.aprovado === true,\n  problemas: Array.isArray(d.problemas) ? d.problemas : [],\n  raciocinio: orig.raciocinio,\n  legenda: d.legenda || orig.legenda,\n  prompt_imagem: d.prompt_imagem || orig.prompt_imagem,\n  narracao: d.narracao || orig.narracao\n} }];"
